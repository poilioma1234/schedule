@model IEnumerable<schedule.Models.TaskItem>
@using schedule.Helpers
@using schedule.Models

@{
    ViewData["Title"] = "Danh sach Nhiem Vu";
}

<div class="container-fluid px-4 py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold">Danh s&#225;ch Nhi&#7879;m V&#7909;</h1>
            <p class="text-muted mb-0">Theo d&#245;i, qu&#7843;n l&#253; v&#224; c&#7853;p nh&#7853;t ti&#7871;n &#273;&#7897; c&#244;ng vi&#7879;c h&#224;ng ng&#224;y.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary shadow-sm" asp-controller="Schedule" asp-action="Create">+ Tạo Lịch Trình</a>
            <a class="btn btn-primary shadow-sm" asp-controller="Tasks" asp-action="Create">+ Tạo Task Mới</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm p-4 mb-4 bg-white">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label fw-bold small text-muted text-uppercase">T&#236;m ki&#7871;m nhi&#7879;m v&#7909;</label>
                <input class="form-control shadow-sm" type="text" id="searchFilter" placeholder="T&#234;n task, l&#7883;ch tr&#236;nh, ng&#432;&#7901;i t&#7841;o..." />
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <label class="form-label fw-bold small text-muted text-uppercase">Tr&#7841;ng th&#225;i</label>
                <select class="form-select shadow-sm" id="statusFilter">
                    <option value="all">T&#7845;t c&#7843;</option>
                    <option value="overdue">Qu&#225; h&#7841;n</option>
                    <option value="completed">Ho&#224;n th&#224;nh</option>
                    <option value="open-today">&#272;ang m&#7903; h&#244;m nay</option>
                </select>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <label class="form-label fw-bold small text-muted text-uppercase">Th&#7901;i gian</label>
                <select class="form-select shadow-sm" id="dateFilter">
                    <option value="all">T&#7845;t c&#7843;</option>
                    <option value="today">H&#244;m nay</option>
                    <option value="7days">7 ng&#224;y t&#7899;i</option>
                    <option value="14days">14 ng&#224;y t&#7899;i</option>
                    <option value="30days">30 ng&#224;y t&#7899;i</option>
                    <option value="custom">T&#249;y ch&#7881;nh...</option>
                </select>
            </div>
            <div class="col-12 col-md-8 col-lg-3 d-none" id="customDateRange">
                <label class="form-label fw-bold small text-muted text-uppercase">Kho&#7843;ng th&#7901;i gian</label>
                <div class="d-flex gap-2 align-items-center">
                    <input type="date" class="form-control form-control-sm shadow-sm" id="dateFrom" />
                    <span class="text-muted fw-bold flex-shrink-0">&#8594;</span>
                    <input type="date" class="form-control form-control-sm shadow-sm" id="dateTo" />
                </div>
            </div>
            <div class="col-12 col-md-4 col-lg-1 ms-auto d-flex align-items-end">
                <button class="btn btn-outline-secondary w-100 shadow-sm" id="resetFilters">
                    <i class="bi bi-x-circle me-1"></i>&#272;&#7863;t l&#7841;i
                </button>
            </div>
        </div>
        <div class="mt-3 d-none" id="filterSummary">
            <span class="text-muted small">&#272;ang l&#7885;c: </span>
            <span id="filterSummaryText" class="small fw-semibold text-primary"></span>
        </div>
    </div>

    <!-- DataTable Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle w-100" id="tasksTable">
                    <thead class="table-light">
                        <tr>
                            <th>T&#234;n nhi&#7879;m v&#7909;</th>
                            <th>H&#7841;n ch&#7889;t</th>
                            <th>Tr&#7841;ng th&#225;i</th>
                            <th>M&#7913;c &#273;&#7897;</th>
                            <th class="text-end">H&#224;nh &#273;&#7897;ng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            var effectiveStatus = TaskDisplayHelper.EffectiveStatus(task, DateTime.Now);
                            var isOverdue = effectiveStatus == TaskItemStatus.Overdue;
                            var isCompleted = effectiveStatus == TaskItemStatus.Completed;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="d-inline-block rounded-circle me-3 shadow-sm" style="width:14px;height:14px;background:@task.Color;min-width:14px;"></span>
                                        <div>
                                            <div class="fw-semibold text-dark mb-0">@task.Title</div>
                                            <small class="text-muted">Thu&#7897;c: <strong class="text-secondary">@(task.ScheduleItem?.Title ?? "L&#7883;ch c&#225; nh&#226;n")</strong> · @task.CreatedByEmail</small>
                                        </div>
                                    </div>
                                </td>
                                <td data-order="@task.Deadline.ToString("yyyy-MM-dd HH:mm")" data-search="@task.Deadline.ToString("yyyy-MM-dd")">
                                    <span class="fw-bold d-block @(isOverdue ? "text-danger" : "text-dark")">@task.Deadline.ToString("dd/MM/yyyy")</span>
                                    <small class="text-muted">@task.Deadline.ToString("HH:mm")</small>
                                </td>
                                <td data-search="status-@effectiveStatus.ToString().ToLower()">
                                    <span class="badge @(isOverdue ? "bg-danger" : (isCompleted ? "bg-success" : "bg-primary")) fw-semibold">
                                        @TaskDisplayHelper.StatusText(effectiveStatus)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary py-2 px-3">@TaskDisplayHelper.PriorityText(task.Priority)</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary shadow-sm rounded-3 px-3">S&#7917;a</a>
                                        <a asp-controller="Schedule" asp-action="Edit" asp-route-id="@task.ScheduleItemId" class="btn btn-sm btn-outline-secondary shadow-sm rounded-3 px-3">M&#7903; l&#7883;ch</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function () {
    function parseIsoDate(str) {
        var m = (str || '').match(/(\d{4})-(\d{2})-(\d{2})/);
        if (!m) return null;
        return new Date(parseInt(m[1]), parseInt(m[2]) - 1, parseInt(m[3]));
    }
    function today() { var d = new Date(); d.setHours(0,0,0,0); return d; }
    function todayPlus(n) { var d = today(); d.setDate(d.getDate() + n); return d; }

    $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
        var statusVal = $('#statusFilter').val();
        var dateVal   = $('#dateFilter').val();
        var statusRaw   = (data[2] || '').toLowerCase();
        var isOverdue   = statusRaw.indexOf('status-overdue') >= 0;
        var isCompleted = statusRaw.indexOf('status-completed') >= 0;
        var deadlineDate = parseIsoDate(data[1]);
        var t = today();
        // "Dang mo hom nay" = chua hoan thanh + deadline hom nay (ke ca qua gio nhung chua xong)
        var isOpenToday = !isCompleted && deadlineDate && deadlineDate.getTime() === t.getTime();

        if (statusVal === 'overdue'    && !isOverdue)   return false;
        if (statusVal === 'completed'  && !isCompleted) return false;
        if (statusVal === 'open-today' && !isOpenToday) return false;

        if (dateVal !== 'all' && deadlineDate) {
            if (dateVal === 'today') {
                if (deadlineDate.getTime() !== t.getTime()) return false;
            } else if (dateVal === '7days') {
                if (deadlineDate < t || deadlineDate >= todayPlus(7)) return false;
            } else if (dateVal === '14days') {
                if (deadlineDate < t || deadlineDate >= todayPlus(14)) return false;
            } else if (dateVal === '30days') {
                if (deadlineDate < t || deadlineDate >= todayPlus(30)) return false;
            } else if (dateVal === 'custom') {
                var fromVal = $('#dateFrom').val();
                var toVal   = $('#dateTo').val();
                if (fromVal) { var f = parseIsoDate(fromVal); if (f && deadlineDate < f) return false; }
                if (toVal)   { var t2 = parseIsoDate(toVal);  if (t2 && deadlineDate > t2) return false; }
            }
        }
        return true;
    });

    var table = $('#tasksTable').DataTable({
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json' },
        pageLength: 10,
        lengthMenu: [5, 10, 25, 50],
        order: [[1, 'asc']],
        columnDefs: [{ orderable: false, targets: 4 }],
        dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'>>" +
             "<'row'<'col-sm-12'tr>>" +
             "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
    });

    function updateSummary() {
        var parts = [];
        if ($('#statusFilter').val() !== 'all')
            parts.push('Trang thai: ' + $('#statusFilter option:selected').text());
        if ($('#dateFilter').val() !== 'all') {
            var dateLabel = $('#dateFilter option:selected').text();
            if ($('#dateFilter').val() === 'custom') {
                var f = $('#dateFrom').val(), t2 = $('#dateTo').val();
                var range = [f, t2].filter(Boolean).join(' -> ');
                if (range) dateLabel = range;
            }
            parts.push('Thoi gian: ' + dateLabel);
        }
        if (parts.length) {
            $('#filterSummary').removeClass('d-none');
            $('#filterSummaryText').text(parts.join(' | '));
        } else {
            $('#filterSummary').addClass('d-none');
        }
    }

    function toggleCustomRange() {
        if ($('#dateFilter').val() === 'custom') {
            $('#customDateRange').removeClass('d-none');
        } else {
            $('#customDateRange').addClass('d-none');
            $('#dateFrom, #dateTo').val('');
        }
    }

    $('#searchFilter').on('keyup', function () { table.search($(this).val()).draw(); });
    $('#statusFilter').on('change', function () { updateSummary(); table.draw(); });
    $('#dateFilter').on('change', function () { toggleCustomRange(); updateSummary(); table.draw(); });
    $('#dateFrom, #dateTo').on('change', function () { updateSummary(); table.draw(); });
    $('#resetFilters').on('click', function () {
        $('#searchFilter').val('');
        $('#statusFilter').val('all');
        $('#dateFilter').val('all');
        $('#dateFrom, #dateTo').val('');
        toggleCustomRange();
        updateSummary();
        table.search('').draw();
    });

    // Pre-set filters from server (e.g. when navigated from Home page)
    var statusFilterInit = '@ViewBag.StatusFilter';
    var dateFilterInit   = '@ViewBag.DateFilter';

    if (statusFilterInit && statusFilterInit !== 'all') {
        $('#statusFilter').val(statusFilterInit);
    }
    if (dateFilterInit && dateFilterInit !== 'all') {
        $('#dateFilter').val(dateFilterInit);
        toggleCustomRange();
    }

    if (statusFilterInit !== 'all' || dateFilterInit !== 'all') {
        updateSummary();
        table.draw();
    }
});
</script>
}


