@model schedule.Models.ScheduleItem

@{
    ViewData["Title"] = "Thêm lịch";
}

<div class="page-heading">
    <h1>Thêm lịch mới</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu lịch</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script>
        const ckConfig = {
            toolbar: {
                items: ['heading', '|', 'bold', 'italic', 'underline', '|',
                        'bulletedList', 'numberedList', '|',
                        'link', 'blockQuote', '|', 'undo', 'redo']
            },
            language: 'vi'
        };

        const scheduleDescEl = document.querySelector('#ck-schedule-desc');
        if (scheduleDescEl) {
            ClassicEditor.create(scheduleDescEl, {
                ...ckConfig,
                placeholder: 'Nhập mô tả lịch trình...'
            }).catch(err => console.error('CKEditor Schedule:', err));
        }
    </script>
}
