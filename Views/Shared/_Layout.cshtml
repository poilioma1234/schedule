@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using schedule.Data
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var showAiChatLauncher = isAuthenticated
        && !string.Equals(currentController, "AiChat", StringComparison.OrdinalIgnoreCase);
    var userEmail = User.Identity?.Name ?? "";
    var userId = isAuthenticated ? UserManager.GetUserId(User) : null;
    string? avatarPath = null;
    string displayName = userEmail;
    var alertCount = 0;
    var today = DateTime.Today;
    var now = DateTime.Now;

    if (isAuthenticated && !string.IsNullOrWhiteSpace(userId))
    {
        var profile = await DbContext.UserProfiles
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.UserId == userId);
        avatarPath = profile?.AvatarPath;
        displayName = string.IsNullOrWhiteSpace(profile?.DisplayName) ? userEmail : profile!.DisplayName;

        var taskQuery = DbContext.TaskItems.AsNoTracking();
        var scheduleQuery = DbContext.ScheduleItems.AsNoTracking();

        if (!isAdmin)
        {
            taskQuery = taskQuery.Where(item => item.CreatedByUserId == userId);
            scheduleQuery = scheduleQuery.Where(item => item.CreatedByUserId == userId);
        }

        var overdueCount = await taskQuery.CountAsync(item => item.Status != schedule.Models.TaskItemStatus.Completed && item.Deadline < now);
        var todayScheduleCount = await scheduleQuery.CountAsync(item => item.StartTime.Date == today);
        alertCount = overdueCount + todayScheduleCount;
    }

    var initial = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Substring(0, 1).ToUpperInvariant();
    string Active(params string[] controllers) => controllers.Contains(currentController, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    string ActiveSchedule() => currentController == "Schedule" && currentAction != "Calendar" ? "active" : "";
    string ActiveCalendar() => currentController == "Schedule" && currentAction == "Calendar" ? "active" : "";
}

