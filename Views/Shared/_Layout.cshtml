    @if (showAiChatLauncher)
    {
        <div class="modal fade ai-chat-popup" id="aiChatPopup" tabindex="-1" aria-labelledby="aiChatPopupLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-5" id="aiChatPopupLabel">AI Chat</h2>
                            <span class="text-muted small">Táº¡o lá»‹ch, task vÃ  phÃ¢n tÃ­ch deadline</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="AiChat" asp-action="Index">Má»Ÿ rá»™ng</a>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ÄÃ³ng"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <iframe
                            class="ai-chat-frame"
                            src="about:blank"
                            data-ai-src="@Url.Action("Index", "AiChat", new { embed = true })"
                            title="AI Chat"></iframe>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (() => {
                const popup = document.getElementById('aiChatPopup');
                if (!popup) {
                    return;
                }

                popup.addEventListener('show.bs.modal', () => {
                    const frame = popup.querySelector('.ai-chat-frame');
                    if (frame && frame.getAttribute('src') === 'about:blank') {
                        frame.setAttribute('src', frame.dataset.aiSrc);
                    }
                });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
