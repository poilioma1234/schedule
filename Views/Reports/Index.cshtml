@{
    ViewData["Title"] = "Báo cáo";
    var completedRate = (int)(ViewBag.TotalTasks == 0 ? 0 : Math.Round(ViewBag.CompletedTasks * 100.0 / ViewBag.TotalTasks));
    var isAdmin = User.IsInRole("Admin");
    var users = ViewBag.Users as List<(string Id, string Email, string DisplayName)> ?? new();
}

<section class="app-page">
    <div class="app-page-heading">
        <div>
            <h1>Báo cáo</h1>
            <p>Xem nhanh tình hình lịch/task trước khi xuất dữ liệu.</p>
        </div>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#exportPdfModal">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Xuất PDF lịch trình
        </button>
    </div>

    <div class="metric-grid four">
        <article class="metric-card blue"><span>Tổng lịch</span><strong>@ViewBag.TotalSchedules</strong><small>Lịch đã tạo</small></article>
        <article class="metric-card green"><span>Task hoàn thành</span><strong>@ViewBag.CompletedTasks</strong><small>@completedRate% tổng task</small></article>
        <article class="metric-card red"><span>Task quá hạn</span><strong>@ViewBag.OverdueTasks</strong><small>Cần xử lý</small></article>
        <article class="metric-card purple"><span>Tổng task</span><strong>@ViewBag.TotalTasks</strong><small>Toàn bộ nhiệm vụ</small></article>
    </div>

    <section class="report-action-grid">
        <article>
            <span>PDF</span>
            <h2>Báo cáo lịch trình</h2>
            <p>Xuất danh sách lịch trình và hoạt động theo user và khoảng thời gian ra PDF.</p>
            <a href="#" data-bs-toggle="modal" data-bs-target="#exportPdfModal">Xuất PDF</a>
        </article>
        <article>
            <span>Chart</span>
            <h2>Phân tích hoạt động</h2>
            <p>Xem biểu đồ task theo ngày, tuần, tháng, năm và phân bổ trạng thái.</p>
            <a asp-controller="Activity" asp-action="Index">Mở hoạt động</a>
        </article>
        <article>
            <span>Rank</span>
            <h2>Hiệu suất người dùng</h2>
            <p>Xem bảng xếp hạng theo ngày, tuần, tháng, năm và huy hiệu top tháng.</p>
            <a asp-controller="Leaderboard" asp-action="Index">Mở bảng xếp hạng</a>
        </article>
    </section>
</section>

<!-- Export PDF Modal -->
<div class="modal fade" id="exportPdfModal" tabindex="-1" aria-labelledby="exportPdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="exportPdfModalLabel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-danger"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Xuất PDF Báo cáo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="exportPdfForm" method="get" action="/Reports/ExportPdf" target="_blank">
                <div class="modal-body p-4">

                    @if (isAdmin)
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold" for="pdfUserId">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                Xuất lịch của ai?
                            </label>
                            <select class="form-select" id="pdfUserId" name="userId">
                                <option value="">Tất cả người dùng</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@(string.IsNullOrWhiteSpace(u.DisplayName) ? u.Email : $"{u.DisplayName} ({u.Email})")</option>
                                }
                            </select>
                            <div class="form-text text-muted">Chọn "Tất cả người dùng" để xuất toàn bộ hệ thống.</div>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Khoảng thời gian
                        </label>
                        <div class="d-flex gap-2 align-items-center">
                            <div class="flex-fill">
                                <label class="form-label small text-muted mb-1">Từ ngày</label>
                                <input type="date" class="form-control" id="pdfFromDate" name="fromDate" />
                            </div>
                            <div class="pt-4 text-muted">—</div>
                            <div class="flex-fill">
                                <label class="form-label small text-muted mb-1">Đến ngày</label>
                                <input type="date" class="form-control" id="pdfToDate" name="toDate" />
                            </div>
                        </div>
                        <div class="form-text text-muted">Để trống để xuất tất cả các ngày.</div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            Nội dung xuất
                        </label>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeSchedules" name="includeSchedules" value="true" checked />
                                <label class="form-check-label" for="includeSchedules">Lịch trình</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeTasks" name="includeTasks" value="true" checked />
                                <label class="form-check-label" for="includeTasks">Danh sách Task</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeActivity" name="includeActivity" value="true" checked />
                                <label class="form-check-label" for="includeActivity">Hoạt động (tóm tắt)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Tải xuống PDF
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
