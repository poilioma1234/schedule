@page
@model schedule.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-shell">
    <div class="auth-card">
        <h1>Đăng nhập</h1>
        <p>Đăng nhập để quản lý lịch trình và công việc của bạn.</p>

        <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mb-3">
            <button type="submit" class="btn google-auth-btn w-100" name="provider" value="Google">
                <span class="google-auth-mark">G</span>
                <span class="google-auth-label">Đăng nhập bằng tài khoản Google</span>
            </button>
        </form>

        <div class="auth-divider">
            <span>hoặc</span>
        </div>

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="Nhập email..." />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check d-flex align-items-center gap-2">
                <input asp-for="Input.RememberMe" class="form-check-input mt-0" />
                <label asp-for="Input.RememberMe" class="form-check-label select-none">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Đăng nhập</button>

            <div class="text-center small">
                <span class="text-muted">Chưa có tài khoản? </span>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary text-decoration-none fw-semibold">Đăng ký ngay</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
